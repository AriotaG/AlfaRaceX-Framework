        "prescaler": 12
      },
      "C2": {
        "bitrate": 500000,
        "prescaler": 12
      },
      "BH": {
        "bitrate": 125000,
        "prescaler": 48
      }
    }
  },
  "interchip_uart": {
    "instance": "USART2",
    "pin": "PA14",
    "baud": 38400,
    "half_duplex": true,
