    "system_clock_hz": 48000000,
    "clock_source": "HSI48",
    "pll_used_for_sysclk": false
  },
  "can": {
    "instance": "bxCAN",
    "pins": {
      "rx": "PB8",
      "tx": "PB9",
      "alternate_function": 4
